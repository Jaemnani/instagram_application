# ───────── 사이트 ─────────
SITE_URL=https://your-domain.com
SITE_NAME=kidding seongsu
# 한국어 표기 — 화면에는 영문을 쓰되 구조화 데이터 alternateName 과
# 본문 첫 언급에 남겨 한국어 브랜드 검색을 놓치지 않는다.
SITE_NAME_KO=키딩성수
SITE_DESCRIPTION=스페셜티 원두를 직접 로스팅하는 동네 카페. 신선한 커피와 수제 디저트.
SITE_LOCALE=ko_KR

# ───────── Instagram Graph API ─────────
# Meta 개발자 콘솔에서 발급. 미설정 시 fixture(데모 데이터)로 동작.
# 스코프: 기본 콘텐츠/좋아요·댓글수 = instagram_business_basic
#         댓글 본문 표시 = instagram_business_manage_comments
IG_USERNAME=demo_roastery
IG_LONG_LIVED_TOKEN=
IG_USER_ID=
IG_APP_ID=
IG_APP_SECRET=
# 이 시각(ISO) 이전 게시물은 사이트에서 제외. 미설정 시 코드 기본값 사용.
IG_SINCE=
# 동기화 cron 엔드포인트 보호용 시크릿
SYNC_SECRET=

# 예약/문의 링크. 미설정 시 인스타 프로필의 website 사용
BOOKING_URL=
# 히어로 배경으로 쓸 게시물 id. 미설정 시 좋아요가 가장 많은 게시물 사진.
HERO_POST_ID=
# 직접 지정한 정적 이미지(public/hero/ 아래) 경로. 설정되면 위 HERO_POST_ID 보다 우선한다.
HERO_IMAGE_SRC=
# 검색엔진 사이트 소유확인 (구글 서치콘솔 / 네이버 서치어드바이저)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# ───────── 지역(Geographic) SEO: LocalBusiness ─────────
BUSINESS_TYPE=ProfessionalService
BIZ_STREET=서울특별시 강남구 테헤란로 123
BIZ_LOCALITY=강남구
BIZ_REGION=서울특별시
BIZ_POSTAL=06234
BIZ_COUNTRY=KR
# 지도 검색어. 도로명주소가 지도에서 엉뚱한 곳에 잡힐 때 지번 주소를 넣는다.
# 로마자 주소 — 영어 화면용 (한글은 지도·택시용으로 항상 병기)
BIZ_ADDRESS_LATIN=
# 일본어/중국어 화면용 그 언어 표기 주소. 비우면 위 로마자 주소로 대체된다.
BIZ_ADDRESS_JA=
BIZ_ADDRESS_ZH=
BIZ_MAP_QUERY=
BIZ_PHONE=+82-2-1234-5678
BIZ_LAT=37.4979
BIZ_LNG=127.0276
BIZ_HOURS=Mo-Fr 08:00-22:00, Sa-Su 09:00-21:00
BIZ_PRICE_RANGE=₩₩
# 서비스 제공 지역 (쉼표 구분, schema.org areaServed)
BIZ_AREA_SERVED=서울 성동구,성수동,서울숲,서울특별시

# ── 측정 (선택) ────────────────────────────────────────────────
# GA4 측정 ID. 비워 두면 애널리틱스 스크립트를 아예 넣지 않는다.
# AI 답변에서 넘어온 방문은 ai_referral 이벤트로 따로 기록된다 —
# GA4 콘솔에서 맞춤 측정기준 `ai_source` 를 한 번 등록해야 리포트에 뜬다.
NEXT_PUBLIC_GA_ID=

# ── 예약 (/book) ────────────────────────────────────────────────
# 바쁜 시간을 읽어올 외부 캘린더 iCal 주소. 한 줄(또는 쉼표)에 하나씩 `이름=주소`.
# 아워플레이스·스페이스클라우드: 호스트 화면의 "캘린더 내보내기" 주소
# 구글: 설정 → 캘린더 통합 → "iCal 형식의 비공개 주소" (URL 구독이 아니라 서버가 직접 읽어 즉시 최신)
# 애플: 캘린더 공유 → "공개 캘린더" 링크 (webcal:// 그대로 넣어도 된다)
# ⚠️ 주소에 비밀 토큰이 들어 있으니 커밋하지 말 것 — .env.local / Vercel env 에만.
BOOKING_ICS_SOURCES=
# 예약용 영업시간. 비우면 BIZ_HOURS 를 쓴다. 형식 동일 (Mo-Fr 10:00-19:00, Sa-Su 10:00-18:00)
BOOKING_HOURS=
# 예약 사이 텀(분), 최소 몇 시간 뒤부터 신청 가능, 며칠 뒤까지 열지
BOOKING_BUFFER_MINUTES=30
BOOKING_MIN_LEAD_HOURS=24
BOOKING_MAX_DAYS=60

# ── 자동 반영 (매주 월요일 03:00 KST cron = vercel.json "0 18 * * 0", UTC 기준) ──
# Vercel 이 cron 호출에 자동으로 실어 보내는 비밀값. 없으면 /api/sync 가 503 으로 잠긴다.
CRON_SECRET=
# Vercel → Settings → Git → Deploy Hooks 에서 main 브랜치로 만든 주소.
# 있으면 cron 이 재배포를 걸고, 빌드의 prebuild(sync)가 새 게시물을 받아온다.
# ⚠️ 이 주소만 알면 누구나 배포를 걸 수 있다 — 커밋 금지, Vercel env 에만.
DEPLOY_HOOK_URL=

# ── 홈페이지 예약 신청 → 애플(iCloud) 캘린더 ─────────────────────
# 셋 다 있으면 /book 에 신청서가 열리고, 신청은 이 캘린더에 "[대기]" 일정으로 들어간다.
# 하나라도 비면 신청서 대신 카카오톡 문의 안내가 나온다.
# 비밀번호는 애플 계정 비밀번호가 아니라 appleid.apple.com → 로그인 및 보안 → "앱 암호".
# ⚠️ 캘린더는 반드시 "공유하지 않는" 캘린더 — 손님 이름·연락처가 들어간다.
# ⚠️ 켜기 전에 개인정보처리방침(사전 privacy)을 "이름·연락처 수집"으로 고칠 것.
APPLE_CALDAV_USER=
APPLE_CALDAV_PASSWORD=
APPLE_BOOKING_CALENDAR=

# ── 네이버 예약 (손님은 네이버에서 직접 예약) ──────────────────────
# 있으면 모든 "예약하기" 버튼과 /book 의 최종 버튼이 여기로 간다. BOOKING_URL 은 카카오톡 문의용.
NAVER_BOOKING_URL=
# 홈페이지 신청서(애플 캘린더 저장)를 켤지. 켜기 전에 개인정보처리방침을 "이름·연락처 수집"으로 고칠 것.
BOOKING_REQUESTS_ENABLED=

# ── 막힌 시간 피드 (아워플레이스 등이 가져가 그 시간을 마감) ───────────
# 주소: https://kidding.kr/api/booking/feed/<이 값>.ics  → 아워플레이스 캘린더 설정 → 외부 캘린더 가져오기
# 주소가 곧 비밀번호다(틀리면 404). `openssl rand -hex 16` 으로 만들 것. 커밋 금지.
BOOKING_FEED_TOKEN=
