# ───────── 사이트 ─────────
SITE_URL=https://your-domain.com
SITE_NAME=데모 로스터리
SITE_DESCRIPTION=스페셜티 원두를 직접 로스팅하는 동네 카페. 신선한 커피와 수제 디저트.
SITE_LOCALE=ko_KR

# ───────── Instagram Graph API ─────────
# Meta 개발자 콘솔에서 발급. 미설정 시 fixture(데모 데이터)로 동작.
# 스코프: 기본 콘텐츠/좋아요·댓글수 = instagram_business_basic
#         댓글 본문 표시 = instagram_business_manage_comments
IG_USERNAME=demo_roastery
IG_LONG_LIVED_TOKEN=
IG_USER_ID=
IG_APP_ID=
IG_APP_SECRET=
# 이 시각(ISO) 이전 게시물은 사이트에서 제외. 미설정 시 코드 기본값 사용.
IG_SINCE=
# 동기화 cron 엔드포인트 보호용 시크릿
SYNC_SECRET=

# ───────── 지역(Geographic) SEO: LocalBusiness ─────────
BUSINESS_TYPE=CafeOrCoffeeShop
BIZ_STREET=서울특별시 강남구 테헤란로 123
BIZ_LOCALITY=강남구
BIZ_REGION=서울특별시
BIZ_POSTAL=06234
BIZ_COUNTRY=KR
BIZ_PHONE=+82-2-1234-5678
BIZ_LAT=37.4979
BIZ_LNG=127.0276
BIZ_HOURS=Mo-Fr 08:00-22:00, Sa-Su 09:00-21:00
BIZ_PRICE_RANGE=₩₩
